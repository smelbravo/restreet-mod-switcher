<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.2.3</Version>
    <ApplicationIcon>switcher.ico</ApplicationIcon>
    <Product>ReStreet Mod Switcher</Product>
    <Description>ReStreet Mod Switcher</Description>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="cover.jpg" LogicalName="cover.jpg" />
    <EmbeddedResource Include="switcher.ico" LogicalName="switcher.ico" />
    <Compile Include="..\..\Installer\FifaStreetSetupTool\ThemeKit.cs" Link="ThemeKit.cs" />
    <Compile Include="..\..\Installer\FifaStreetSetupTool\ThirdParty\LzxDecoder.cs" Link="ThirdParty\LzxDecoder.cs" />
    <Compile Include="..\..\Tools\ReStreetAssetScan\Textures.cs" Link="Textures.cs" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <None Include="ui\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
